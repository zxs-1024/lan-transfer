{
  "manifest_version": 3,
  "name": "邻传",
  "version": "1.0.0",
  "description": "在本机下载文件，或让同一局域网内的手机扫码下载。",
  "permissions": [
    "downloads"
  ],
  "host_permissions": [
    "http://127.0.0.1:34567/*"
  ],
  "action": {
    "default_title": "邻传",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
